# Copy to .env.local for machine-specific overrides (not committed).
# Overrides .env — use for local DB password, ports, etc.

PORT=4000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=

# Optional: comma-separated origins for local frontend (Vite default :5173)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
