# Local development defaults (overridden by .env.local if present)
# Server deploy: set NODE_ENV=production and use .env.production on the host.

NODE_ENV=development
PORT=5001

DB_HOST=localhost
DB_PORT=3306
DB_NAME=money_trend
DB_USER=root
DB_PASSWORD=

JWT_ACCESS_SECRET=dev_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=dev_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CORS_ORIGIN=*
UPLOAD_DIR=uploads
PII_ENCRYPTION_KEY=dev_pii_encryption_key_change_in_production_32chars

ADMIN_EMAIL=admin@moneytrend.in
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=9999999999

# Bank external FD/RD rate APIs (optional — leave blank to use RBI-aligned fallback)
SBI_FD_API_URL=
SBI_API_KEY=
HDFC_FD_API_URL=
HDFC_API_KEY=
ICICI_FD_API_URL=
ICICI_API_KEY=
AXIS_FD_API_URL=
AXIS_API_KEY=
OTHER_BANK_API_URL=
OTHER_BANK_API_KEY=
PNB_FD_API_URL=
PNB_API_KEY=
BOB_FD_API_URL=
BOB_API_KEY=
KOTAK_FD_API_URL=
KOTAK_API_KEY=

# Razorpay (wallet deposits)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin platform fee on FD/RD investment (must be between 2 and 3)
ADMIN_COMMISSION_PERCENT=2.5

# Credit bureau APIs
# sandbox = mock responses (default, safe for local/dev)
# live / uat / production / experian_live = call Experian India over OAuth
CREDIT_CHECK_MODE=sandbox

# Experian India (never use US host sandbox-us-api.experian.com)
EXPERIAN_ENV=sandbox
EXPERIAN_SANDBOX_BASE_URL=https://sandbox-in-api.experian.com
EXPERIAN_UAT_BASE_URL=https://uat-in-api.experian.com
EXPERIAN_PRODUCTION_BASE_URL=https://in-api.experian.com

# Portal OAuth credentials (server-side only — never expose to React)
EXPERIAN_USERNAME=
EXPERIAN_PASSWORD=
EXPERIAN_CLIENT_ID=
EXPERIAN_CLIENT_SECRET=

# Official Experian India credit-check path from your entitlement docs, e.g. /powercurve/...
# Combined as: ${EXPERIAN_*_BASE_URL}${EXPERIAN_CREDIT_CHECK_ENDPOINT}
EXPERIAN_CREDIT_CHECK_ENDPOINT=

# Optional: absolute or cwd-relative module exporting a mapper function for the request body
# EXPERIAN_CREDIT_CHECK_MAPPER_MODULE=services/credit-bureau/mappers/myExperianMapper.js

# Dev-only: allow a non-official template body for connectivity tests (never in production)
EXPERIAN_CREDIT_CHECK_ALLOW_DEV_TEMPLATE=false

# Refresh-token flow (fallback to password grant on failure)
EXPERIAN_REFRESH_ENABLED=true
EXPERIAN_TOKEN_SKEW_MS=60000

# Legacy aliases (optional overrides)
EXPERIAN_API_BASE_URL=
EXPERIAN_API_KEY=

CIBIL_API_BASE_URL=
CIBIL_API_KEY=
CIBIL_CLIENT_ID=
EQUIFAX_API_BASE_URL=
EQUIFAX_API_KEY=
CRIF_API_BASE_URL=
CRIF_API_KEY=

# FD/RD rate ticker (syncs from existing bank adapters in services/banks/)
FD_RD_SYNC_INTERVAL=3600
FD_RD_CACHE_TTL=60
FD_RD_TICKER_LIMIT=10

# SMS OTP (sandbox logs OTP to console; use msg91 or twilio in production)
SMS_MODE=sandbox
APP_NAME=Money Trend
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=15
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_SENDS_PER_WINDOW=3
OTP_SEND_WINDOW_MINUTES=15
OTP_MAX_VERIFY_ATTEMPTS=5
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MNYTRD
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Support tickets — emails go to SUPPORT_EMAIL (default info@moneytrend.in)
SUPPORT_EMAIL=info@moneytrend.in
# SMTP (optional). If blank, ticket emails are logged to console (sandbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Money Trend Support <noreply@moneytrend.in>"
