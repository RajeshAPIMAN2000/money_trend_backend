# Local development defaults (overridden by .env.local if present)
# Server deploy: set NODE_ENV=production and use .env.production on the host.

NODE_ENV=development
PORT=5001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=money_trend
DB_USER=moneytrend
DB_PASSWORD=M0neyTrend_DB_2026_Secure!

JWT_ACCESS_SECRET=dev_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=dev_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES=10h
JWT_REFRESH_EXPIRES=7d

# =============================================================================
# Dummy payment gateway (bank / stakeholder demos — no real charges)
# =============================================================================
DUMMY_PAYMENT_ENABLED=true
DUMMY_PAYMENT_CIBIL_FEE=99
DUMMY_PAYMENT_OTP=1234
# Demo investment UAT layer (virtual funds; separate from Razorpay)
DEMO_MODE=true
# When true, CIBIL report download requires a successful dummy cibil_report payment
DUMMY_PAYMENT_REQUIRE_CIBIL=false

CORS_ORIGIN=*
UPLOAD_DIR=uploads
PII_ENCRYPTION_KEY=dev_pii_encryption_key_change_in_production_32chars

ADMIN_EMAIL=rudraraay@gmail.com
ADMIN_PASSWORD="Moneytrend@2026#"
ADMIN_PHONE=9876500001
SUPER_ADMIN_1_EMAIL=rudraraay@gmail.com
SUPER_ADMIN_1_PASSWORD="Moneytrend@2026#"
SUPER_ADMIN_1_PHONE=9876500001
SUPER_ADMIN_2_EMAIL=manojrout2019@gmail.com
SUPER_ADMIN_2_PASSWORD=Money8908@
SUPER_ADMIN_2_PHONE=9876500002

# Bank external FD/RD rate APIs (optional — leave blank to use RBI-aligned fallback)
SBI_FD_API_URL=
SBI_API_KEY=
HDFC_FD_API_URL=
HDFC_API_KEY=
ICICI_FD_API_URL=
ICICI_API_KEY=
AXIS_FD_API_URL=
AXIS_API_KEY=
OTHER_BANK_API_URL=
OTHER_BANK_API_KEY=
PNB_FD_API_URL=
PNB_API_KEY=
BOB_FD_API_URL=
BOB_API_KEY=
KOTAK_FD_API_URL=
KOTAK_API_KEY=

# Razorpay (wallet deposits)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin platform fee on FD/RD investment (must be between 2 and 3)
ADMIN_COMMISSION_PERCENT=2.5

# Credit bureau APIs
# sandbox = mock responses (default, safe for local/dev)
# uat / test / live / production = call real bureau APIs (Equifax CDS / Experian / etc.)
CREDIT_CHECK_MODE=sandbox

# Credit-check cooldown (hours) per user/phone + bureau.
# sandbox/mock/dev defaults to 0 (no cooldown) so local frontend testing is unrestricted.
# Set e.g. 24 for production. Or CREDIT_CHECK_DISABLE_RATE_LIMIT=true to force off.
# CREDIT_CHECK_RATE_LIMIT_HOURS=0
# CREDIT_CHECK_DISABLE_RATE_LIMIT=true

# Optional: show SAMPLE lenders/accounts in sandbox UI demos (default false = no fake HDFC/etc.)
# CREDIT_CHECK_MOCK_RICH=false

# =============================================================================
# Equifax Consumer Engagement Suite (B2B2C) — jwt-bearer dual tokens
# Enrollment token (scope=enrollment) vs Delivery token (scope=delivery)
#
# Auth (from Equifax collections):
#   POST /personal/consumer-data-suite/oauth/generate-jwt-claim
#   POST /personal/consumer-data-suite/oauth/token  (grant_type=jwt-bearer)
# =============================================================================
EQUIFAX_ENABLED=true
EQUIFAX_ENV=sandbox
EQUIFAX_BASE_URL=https://api.sandbox.equifax.com
EQUIFAX_SANDBOX_BASE_URL=https://api.sandbox.equifax.com
EQUIFAX_UAT_BASE_URL=https://api.uat.equifax.com
EQUIFAX_PRODUCTION_BASE_URL=https://api.equifax.com

# Local testing without Equifax portal keys (default ON when keys missing in sandbox)
# Set EQUIFAX_MOCK=false and provide keys below to hit real Equifax Sandbox APIs
EQUIFAX_MOCK=true

EQUIFAX_CLIENT_ID=
EQUIFAX_CLIENT_SECRET=

# Required for live jwt-bearer generate-jwt-claim (never commit real values)
EQUIFAX_SYMMETRIC_KEY=
EQUIFAX_BASE64_PRIVATE_KEY=

# Sandbox fixtures default when EQUIFAX_ENV=sandbox; set explicit values for UAT/Live
EQUIFAX_ENROLLMENT_API_KEY=
EQUIFAX_DELIVERY_API_KEY=
EQUIFAX_ENROLLMENT_SUBJECT=
EQUIFAX_DELIVERY_SUBJECT=
EQUIFAX_JWT_ISSUER=EFX
EQUIFAX_JWT_EXPIRATION=59

EQUIFAX_TIMEOUT_MS=30000
EQUIFAX_TOKEN_SKEW_SECONDS=60

EQUIFAX_ENROLLMENT_SCOPE=https://api.equifax.com/personal/consumer-data-suite/v1/enrollment
EQUIFAX_CREDIT_SCORE_SCOPE=https://api.equifax.com/personal/consumer-data-suite/v1/creditScore
EQUIFAX_CREDIT_REPORT_SCOPE=https://api.equifax.com/personal/consumer-data-suite/v1/creditReport
EQUIFAX_CREDIT_MONITORING_SCOPE=https://api.equifax.com/personal/consumer-data-suite/v1/creditMonitoring

# CIBIL user score card backend:
#   auto (default) | equifax | native
CIBIL_PROVIDER=auto
CIBIL_MULTI_BUREAU=true
CIBIL_SUITE_BUREAUS=CIBIL,EXPERIAN,EQUIFAX

# App names (reference only — put real Client ID/Secret in server .env, never commit secrets)
# Experian app: Moneytrend Credit Checker
# Equifax app:  MoneyTrend Credit Check

# Legacy single-key aliases (optional)
EQUIFAX_API_KEY=

CIBIL_API_BASE_URL=
CIBIL_API_KEY=
CIBIL_CLIENT_ID=
CRIF_API_BASE_URL=
CRIF_API_KEY=

# =============================================================================
# Experian India (never use US host sandbox-us-api.experian.com)
# =============================================================================
EXPERIAN_ENV=sandbox
EXPERIAN_SANDBOX_BASE_URL=https://sandbox-in-api.experian.com
EXPERIAN_UAT_BASE_URL=https://uat-in-api.experian.com
EXPERIAN_PRODUCTION_BASE_URL=https://in-api.experian.com
EXPERIAN_USERNAME=
EXPERIAN_PASSWORD=
EXPERIAN_CLIENT_ID=
EXPERIAN_CLIENT_SECRET=
EXPERIAN_CREDIT_CHECK_ENDPOINT=
# EXPERIAN_CREDIT_CHECK_MAPPER_MODULE=services/credit-bureau/mappers/myExperianMapper.js
EXPERIAN_CREDIT_CHECK_ALLOW_DEV_TEMPLATE=false
EXPERIAN_REFRESH_ENABLED=true
EXPERIAN_TOKEN_SKEW_MS=60000
EXPERIAN_API_BASE_URL=
EXPERIAN_API_KEY=

# FD/RD rate ticker (syncs from existing bank adapters in services/banks/)
FD_RD_SYNC_INTERVAL=3600
FD_RD_CACHE_TTL=60
FD_RD_TICKER_LIMIT=10

# SMS OTP (sandbox logs OTP to console; use msg91 or twilio in production)
SMS_MODE=sandbox
APP_NAME=Money Trend
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=15
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_SENDS_PER_WINDOW=3
OTP_SEND_WINDOW_MINUTES=15
OTP_MAX_VERIFY_ATTEMPTS=5
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MNYTRD
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Support tickets — emails go to SUPPORT_EMAIL (default info@moneytrend.in)
SUPPORT_EMAIL=info@moneytrend.in

# =============================================================================
# Transactional email — MoneyTrend mailbox
# Hostinger VPS: use smtp.hostinger.com (create mailbox in hPanel).
# GoDaddy MX: use smtpout.secureserver.net if mail still lives there.
# NEVER use EMAIL_PROVIDER=sandbox in production — OTPs will not arrive.
# NEVER commit real mailbox passwords — put them only in server .env
# =============================================================================
EMAIL_PROVIDER=smtp
MAIL_FROM_NAME=Money Trend
MAIL_FROM_EMAIL=info@moneytrend.in
MAIL_REPLY_TO=info@moneytrend.in
PUBLIC_BASE_URL=https://api.moneytrend.in
# Artboard + logo (CID attached; https URLs help Gmail show backgrounds)
MAIL_LOGO_PATH=/uploads/money-trend-logo.png
MAIL_LOGO_URL=https://api.moneytrend.in/uploads/money-trend-logo.png
MAIL_BG_URL=https://api.moneytrend.in/uploads/background-image.png

# --- Hostinger mailbox SMTP (recommended for Hostinger VPS) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@moneytrend.in
SMTP_PASS=
SMTP_FROM=MoneyTrend <info@moneytrend.in>

# --- Email campaigns (blog/news + investment attraction) ---
CONTENT_EMAIL_NOTIFY_ENABLED=true
CONTENT_EMAIL_POLL_MINUTES=60
INVESTMENT_EMAIL_ENABLED=true
# Hours between investment attraction emails (168 = weekly)
INVESTMENT_EMAIL_INTERVAL_HOURS=168
EMAIL_CAMPAIGN_BATCH_SIZE=25
EMAIL_CAMPAIGN_BATCH_DELAY_MS=800
# Frontend links used inside campaign emails
# FRONTEND_ORIGIN=https://moneytrend.in

# --- GoDaddy mailbox SMTP (only if MX still points to secureserver.net) ---
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@moneytrend.in
# SMTP_PASS=

# Optional Resend (only if you switch EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Email OTP security
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_EMAIL=5
OTP_SEND_WINDOW_MINUTES=15
OTP_MAX_SENDS_PER_IP=20
OTP_IP_WINDOW_MINUTES=15
OTP_HASH_PEPPER=
EMAIL_OTP_LOGIN_REQUIRED=true
