NODE_ENV=production
HOST=127.0.0.1
PORT=5001
TRUST_PROXY=1

# MySQL on the same VPS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=money_trend
DB_USER=moneytrend
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES=10h
JWT_REFRESH_EXPIRES=7d

# Dummy payment gateway (bank demos — no real charges)
DUMMY_PAYMENT_ENABLED=true
DUMMY_PAYMENT_CIBIL_FEE=99
DUMMY_PAYMENT_REQUIRE_CIBIL=false

# Comma-separated frontend origins (no trailing slash). Use your real domain(s).
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_ORIGIN=https://yourdomain.com
PUBLIC_BASE_URL=https://yourdomain.com
APP_URL=https://yourdomain.com
APP_NAME=MoneyTrend

UPLOAD_DIR=/var/www/moneytrend/uploads
PII_ENCRYPTION_KEY=CHANGE_ME_PII_KEY_MIN_32_CHARS____________

ADMIN_EMAIL=rudraraay@gmail.com
ADMIN_PASSWORD=Moneytrend@2026#
ADMIN_PHONE=9876500001
SUPER_ADMIN_1_EMAIL=rudraraay@gmail.com
SUPER_ADMIN_1_PASSWORD=Moneytrend@2026#
SUPER_ADMIN_1_PHONE=9876500001
SUPER_ADMIN_2_EMAIL=manojrout2019@gmail.com
SUPER_ADMIN_2_PASSWORD=Money8908@
SUPER_ADMIN_2_PHONE=9876500002

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

ADMIN_COMMISSION_PERCENT=2.5

CREDIT_CHECK_MODE=sandbox

FD_RD_SYNC_INTERVAL=3600
FD_RD_CACHE_TTL=60
FD_RD_TICKER_LIMIT=10

# Production SMS (msg91 or twilio). sandbox only for testing.
SMS_MODE=sandbox
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_MINUTES=15
OTP_MAX_VERIFY_ATTEMPTS=5
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MNYTRD
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# =============================================================================
# EMAIL (REQUIRED on Hostinger VPS — sandbox is BLOCKED in production)
# Create mailbox in Hostinger hPanel → Emails → Email Accounts
# Then use these SMTP settings (password = mailbox password, not hPanel password)
# =============================================================================
EMAIL_PROVIDER=smtp
MAIL_FROM_NAME=MoneyTrend
MAIL_FROM_EMAIL=info@yourdomain.com
MAIL_REPLY_TO=info@yourdomain.com
SUPPORT_EMAIL=info@yourdomain.com
MAIL_LOGO_URL=https://yourdomain.com/uploads/money-trend-logo.png

# --- Hostinger mailbox (recommended when site + mail are on Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@yourdomain.com
SMTP_PASS=CHANGE_ME_MAILBOX_PASSWORD

# --- Alternative: GoDaddy mailbox (only if MX still points to GoDaddy) ---
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@yourdomain.com
# SMTP_PASS=CHANGE_ME_MAILBOX_PASSWORD

# Optional: if TLS verify fails on some VPS images (prefer fixing CA first)
# SMTP_TLS_REJECT_UNAUTHORIZED=false

EMAIL_OTP_LOGIN_REQUIRED=true
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_EMAIL=5
OTP_MAX_SENDS_PER_IP=20
OTP_IP_WINDOW_MINUTES=15
OTP_HASH_PEPPER=CHANGE_ME_OTP_PEPPER_MIN_16_CHARS
