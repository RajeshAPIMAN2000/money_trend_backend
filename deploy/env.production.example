NODE_ENV=production
HOST=127.0.0.1
PORT=5001
TRUST_PROXY=1

# MySQL on the same VPS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=money_trend
DB_USER=moneytrend
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Comma-separated frontend origins (no trailing slash). Use your real domain(s).
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_ORIGIN=https://yourdomain.com

UPLOAD_DIR=/var/www/moneytrend/uploads
PII_ENCRYPTION_KEY=CHANGE_ME_PII_KEY_MIN_32_CHARS____________

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_PHONE=9999999999

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

ADMIN_COMMISSION_PERCENT=2.5

CREDIT_CHECK_MODE=sandbox

FD_RD_SYNC_INTERVAL=3600
FD_RD_CACHE_TTL=60
FD_RD_TICKER_LIMIT=10

# Production SMS (msg91 or twilio). sandbox only for testing.
SMS_MODE=sandbox
APP_NAME=Money Trend
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=15
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_SENDS_PER_WINDOW=3
OTP_SEND_WINDOW_MINUTES=15
OTP_MAX_VERIFY_ATTEMPTS=5
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MNYTRD
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
